# ===========================================================================
# Server Configuration
# ===========================================================================
# The network port the HTTP server binds to (default: 1337)
PORT=1337

# The absolute public URL of your deployed addon (e.g., https://yourdomain.com)
# This is critical for generating stream resolution proxy links (/resolve).
ADDON_BASE_URL=http://localhost:1337

# ===========================================================================
# Logger Configuration
# ===========================================================================
# Log level: "error", "warn", "info", "debug", or "trace" (default: info)
EASYNEWS_LOG_LEVEL=info

# Deduplicate repeating debug log patterns dynamically to keep outputs clean
# Options: "true" or "false" (default: true)
EASYNEWS_SUMMARIZE_LOGS=true


# ===========================================================================
# Secure Addon Configuration
# ===========================================================================
# REQUIRED for production. Generate once with: openssl rand -base64 32
# Keep this value stable across restarts; changing it invalidates installed
# encrypted config and resolver tokens.
ADDON_CONFIG_KEY=

# Legacy compatibility only. When false (recommended/default), plaintext
# username/password config URLs are rejected and the HTML configurator fails
# closed if sealing is unavailable.
ALLOW_LEGACY_PLAINTEXT_CONFIG=false

# ===========================================================================
# API Metadata Integration Options
# ===========================================================================
# Preferred TMDB authentication: API Read Access Token. It is sent only in the
# Authorization: Bearer header and is never placed in a request URL.
TMDB_ACCESS_TOKEN=

# Legacy compatibility: TMDB v3 API key. Used only when TMDB_ACCESS_TOKEN is empty.
# Existing deployments can keep this value; new deployments should prefer the token above.
TMDB_API_KEY=

# ===========================================================================
# Performance & API Cache Throttling
# ===========================================================================
# Bounded limit for total raw matching search results across pagination pages (default: 500)
TOTAL_MAX_RESULTS=500

# Bounded limit of successive Solr pages parsed per request (default: 10)
MAX_PAGES=10

# Bounded limit of files requested from Easynews in a single page (default: 250)
MAX_RESULTS_PER_PAGE=250

# Global advanced search API response cache duration in hours (default: 24)
CACHE_TTL=24

# Total entries retained by the Easynews search cache and final request cache.
# Expired entries are reclaimed first, then least-recently-used entries are
# evicted (default: 1000).
MAX_CACHE_ENTRIES=1000

# Capacity of each metadata lookup cache (TMDB/IMDb/Cinemeta layers; default: 2000).
METADATA_CACHE_ENTRIES=2000

# Emit aggregate, non-secret cache statistics every N stream requests (default: 100).
# Set to 0 to disable periodic cache-stat logging.
CACHE_STATS_LOG_EVERY=100

# Number of search queries resolved concurrently when fanning out (default: 5)
SEARCH_CONCURRENCY=5

# Number of UNIQUE metadata-prevalidated candidates required before the query
# fan-out cancels remaining searches (default: 15). Raw Solr hits do not count.
EARLY_EXIT_CANDIDATES=15


# ===========================================================================
# Stremio Response Cache Hints
# ===========================================================================
# Allow a stale cached stream response to be served while it is revalidated.
# This maps to Cache-Control: stale-while-revalidate (default: 3600 seconds).
STREMIO_STALE_REVALIDATE_SECONDS=3600

# Allow a stale cached stream response to be served when revalidation fails.
# This maps to Cache-Control: stale-if-error (default: 86400 seconds).
STREMIO_STALE_ERROR_SECONDS=86400

# ===========================================================================
# Secure Resolving Proxy Options
# ===========================================================================
# Resolved geography-aware CDN URL cache duration in seconds (default: 300)
RESOLVE_CACHE_TTL_SECONDS=300

# Maximum encrypted resolver/CDN cache entries retained in memory (default: 5000).
RESOLVE_CACHE_ENTRIES=5000

# Overall timeout in milliseconds for retrieving a CDN redirect target (default: 20000).
# Batch 9 shares this deadline across internal resolver attempts.
RESOLVE_TIMEOUT_MS=20000

# Number of internal Easynews resolver attempts on transient failures or a
# temporary direct-content/no-redirect response. Clamped to 1-3 (default: 2).
RESOLVE_ATTEMPTS=2

# Delay in milliseconds between resolver attempts (default: 250).
RESOLVE_RETRY_DELAY_MS=250

# Migration compatibility for pre-Batch-8 reversible Base64 resolver payloads.
# Keep false. Temporarily enable only if old client-side cached stream URLs must
# continue working during a controlled rollout. New URLs still prefer encryption.
ALLOW_LEGACY_RESOLVE_PAYLOADS=false

# Extreme legacy mode: embed credentials directly in Easynews play URLs.
# Keep false. Enabling this exposes the Easynews password in plaintext URLs.
ALLOW_INSECURE_CREDENTIAL_URLS=false
